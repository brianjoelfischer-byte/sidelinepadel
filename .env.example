# Copiar a .env.local y completar. .env* está en .gitignore: nunca se commitea.
#
# Regla 23 del BLUEPRINT: solo lo que puede ser público lleva NEXT_PUBLIC_.
# Todo lo demás es secreto de servidor y se lee vía serverEnv() en src/lib/env.ts.

# ---------------------------------------------------------------------------
# Público — llega al navegador
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase. Estos DOS valores son públicos por diseño: la anon key está pensada
# para vivir en el bundle del cliente. Su seguridad depende enteramente de que
# RLS esté bien escrito — por eso el bloque 2 fue antes que cualquier pantalla.
# Los sacás de: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Servidor — NUNCA al bundle, nunca a un chat, nunca a un commit
# ---------------------------------------------------------------------------

# Cadena de conexión a Postgres. Lleva la contraseña de la base: es el secreto
# de verdad de este archivo. Solo la usan las migraciones y los tests de RLS.
#
# Se saca de: Connect → Session pooler (o Direct connection).
# NO uses el Transaction pooler (puerto 6543) para migraciones: no soporta
# sentencias preparadas ni scripts DDL multi-sentencia.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@<host>:5432/postgres

# Acceso administrativo que se saltea RLS. Solo para jobs de servidor
# (Project Settings → API → service_role).
# SUPABASE_SERVICE_ROLE_KEY=

# Bloque 10 · recordatorios
# CRON_SECRET=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Bloque 14 · endurecimiento
# IP_PEPPER=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
