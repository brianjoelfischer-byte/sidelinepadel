# Copiar a .env.local y completar. .env* está en .gitignore: nunca se commitea.
#
# Regla 23 del BLUEPRINT: solo lo que puede ser público lleva NEXT_PUBLIC_.
# Todo lo demás es secreto de servidor y se lee vía serverEnv() en src/lib/env.ts.

# --- Público (llega al navegador) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Servidor (nunca al bundle) ---
# Se completan en los bloques siguientes:
#   Bloque 2-3 · Supabase
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
#
#   Bloque 10 · recordatorios
# CRON_SECRET=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
#
#   Bloque 14 · endurecimiento
# IP_PEPPER=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
