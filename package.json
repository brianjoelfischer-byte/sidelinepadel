{
  "name": "sidelinepadel",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/check-env.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:rls": "vitest run --project rls",
    "check": "npm run typecheck && npm run lint && npm run test:unit",
    "db:start": "./scripts/db-local.sh start",
    "db:stop": "./scripts/db-local.sh stop",
    "db:reset": "./scripts/db-local.sh reset && node scripts/db-migrate.mjs --reset",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:bundle": "node scripts/db-bundle.mjs"
  },
  "overrides": {
    "@eslint/config-array": "^0.23.5",
    "minimatch": "^10.2.6",
    "postcss": "^8.5.24",
    "sharp": "^0.35.3"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "next": "^16.2.12",
    "next-intl": "^4.13.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.2.12",
    "postcss": "^8.5.24",
    "postgres": "^3.4.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
